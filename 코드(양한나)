score = 0
total = len(QUIZ_DATA)

print_styled("==================================================================", Styles.HEADER + Styles.BOLD)
print_styled("  🏆 파이썬 기초 문법 종합 테스트 퀴즈를 시작합니다! 🏆", Styles.HEADER + Styles.BOLD)
print_styled("==================================================================", Styles.HEADER + Styles.BOLD)
print("질문을 꼼꼼히 읽고 정답 번호를 골라주세요.\n")
time.sleep(0.5)

for idx, q in enumerate(QUIZ_DATA, 1):
    print("-" * 65)
    print_styled(f"Q{idx}. [{q['category']}]", Styles.CYAN)
    print_styled(q['question'], Styles.BOLD)
    print()
    for i, opt in enumerate(q['options'], 1):
        print(f"  {i}) {opt}")
    print()
    
    while True:
        try:
            ans_str = input(f"[Q{idx}] 정답 번호 입력 (1~4): ").strip()
            if not ans_str:
                continue
            ans = int(ans_str)
            if 1 <= ans <= 4:
                break
            print_styled("⚠️ 1번에서 4번 사이의 숫자를 입력해주세요.", Styles.WARNING)
        except ValueError:
            print_styled("⚠️ 숫자를 입력해주세요.", Styles.WARNING)
        except EOFError:
            print_styled("⚠️ 입력 스트림 오류가 발생했습니다. 다시 입력해주세요.", Styles.WARNING)
            
    print()
    if ans == q['answer']:
        print_styled("🎉 정답입니다! 대단하군요!", Styles.GREEN + Styles.BOLD)
        score += 1
    else:
        print_styled("❌ 오답입니다! 아쉽네요.", Styles.FAIL + Styles.BOLD)
        print_styled(f"  정답은 {q['answer']}번: {q['options'][q['answer']-1]} 입니다.", Styles.WARNING)
        
    print(f"\n💡 해설: {q['explanation']}")
    print("-" * 65)
    
    # [코랩 먹통 방지] 엔터 대기용 input()을 과감히 제거하고 1.5초간 해설을 읽을 시간을 준 뒤 다음 문제로 자동 전환합니다.
    time.sleep(1.5)

print("\n" + "=" * 65)
print_styled("🏁 퀴즈를 모두 완료하셨습니다! 🏁", Styles.HEADER + Styles.BOLD)
print(f"정답 개수: {score} / {total}")
score_pct = int((score / total) * 100)
print(f"최종 점수: {score_pct}점")
print("=" * 65)

if score_pct == 100:
    print_styled("🏅 완벽합니다! 파이썬 기초 문법 마스터로 임명합니다!", Styles.GREEN + Styles.BOLD)
elif score_pct >= 80:
    print_styled("🥈 훌륭해요! 대부분의 핵심 문법을 확실하게 이해하고 계십니다!", Styles.BLUE + Styles.BOLD)
elif score_pct >= 50:
    print_styled("🥉 조금만 더 연습하면 되겠어요! 헷갈린 부분을 다시 한 번 복습해 봅시다!", Styles.WARNING + Styles.BOLD)
else:
    print_styled("🌱 괜찮습니다! 코드를 여러 번 타이핑하고 연습하다 보면 금방 익숙해질 거예요. 다시 도전해 봐요!", Styles.CYAN + Styles.BOLD)
