# 이 셀을 실행하여 종합 퀴즈 게임을 시작하세요!
import time

class Styles:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    CYAN = '\033[96m'

# [오류 해결] 따옴표와 괄호가 꼬여있던 문법 오류(SyntaxError)를 완벽하게 수정했습니다.
def print_styled(text, style=""):
    if style:
        print(f"{style}{text}{Styles.ENDC}")
    else:
        print(text)

QUIZ_DATA = [
