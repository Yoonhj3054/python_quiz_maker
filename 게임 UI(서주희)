import streamlit as st  # Streamlit 라이브러리를 불러옵니다.

# 웹 페이지의 타이틀, 아이콘, 레이아웃을 설정합니다.
st.set_page_config(
    page_title="파이썬 문법 마스터 퀴즈",  # 웹 브라우저 탭에 표시될 제목입니다.
    page_icon="🐍",  # 웹 브라우저 탭에 표시될 파이썬 모양의 귀여운 아이콘입니다.
    layout="centered"  # 화면 중앙에 콘텐츠가 보기 좋게 배치되도록 설정합니다.
)

# --- [퀴즈 데이터 정의] ---
# 게임에서 사용할 5개의 파이썬 문법 퀴즈 문항을 딕셔너리 리스트로 구성합니다.
QUIZ_DATA = [
    {
        "question": "Python에서 리스트의 가장 마지막에 새로운 요소를 추가하는 메서드는 무엇일까요?",
        "options": ["append()", "add()", "insert()", "push()"],
        "answer": "append()",
        "exp": 100
    },
    {
        "question": "Python에서 리스트나 문자열의 길이를 구하는 내장 함수는 무엇일까요?",
        "options": ["len()", "length()", "size()", "count()"],
        "answer": "len()",
        "exp": 100
    },
    {
        "question": "다음 중 Python에서 한 줄 주석을 작성할 때 사용하는 기호는 무엇일까요?",
        "options": ["#", "//", "/* */", "--"],
        "answer": "#",
        "exp": 100
    },
    {
        "question": "Python에서 두 개 이상의 조건을 모두 만족해야 참(True)이 되는 논리 연산자는?",
        "options": ["and", "or", "not", "&&"],
        "answer": "and",
        "exp": 100
    },
    {
        "question": "반복문(for, while) 안에서 현재 루프를 건너뛰고 다음 반복으로 즉시 넘어갈 때 사용하는 키워드는?",
        "options": ["continue", "break", "pass", "exit"],
        "answer": "continue",
        "exp": 100
    }
]

# --- [세션 상태 관리] ---
# 세션 상태(st.session_state)를 활용해 화면 간의 이동을 제어합니다. (기본값은 메인 화면 'main'입니다.)
if "page" not in st.session_state:
    st.session_state.page = "main"

# 입력받은 플레이어의 학번을 기억하기 위한 세션 변수입니다.
if "student_id" not in st.session_state:
    st.session_state.student_id = ""

# 입력받은 플레이어의 이름을 기억하기 위한 세션 변수입니다.
if "student_name" not in st.session_state:
    st.session_state.student_name = ""

# 플레이어의 현재 획득 점수(EXP)를 관리하는 세션 변수입니다.
if "score" not in st.session_state:
    st.session_state.score = 0

# 현재 풀고 있는 퀴즈의 번호를 나타내는 세션 변수입니다. (1부터 시작)
if "current_question" not in st.session_state:
    st.session_state.current_question = 1

# 전체 문제 개수를 설정합니다.
if "total_questions" not in st.session_state:
    st.session_state.total_questions = len(QUIZ_DATA)

# 현재 문제에 대한 답변을 제출했는지 여부를 판별하는 변수입니다.
if "answered" not in st.session_state:
    st.session_state.answered = False

# 방금 푼 문제가 정답인지 여부를 저장하는 변수입니다.
if "is_correct" not in st.session_state:
    st.session_state.is_correct = False

# 게임이 완전히 종료되었는지 여부를 판별하는 변수입니다.
if "game_over" not in st.session_state:
    st.session_state.game_over = False

# --- [상태 초기화 함수] ---
def reset_game():
    # 게임 스코어 및 모든 진행 관련 변수들을 초기 상태로 초기화합니다.
    st.session_state.score = 0
    st.session_state.current_question = 1
    st.session_state.answered = False
    st.session_state.is_correct = False
    st.session_state.game_over = False


# --- 1. [게임 시작 메인 화면] 정의 함수 ---
def show_main_page():
    # 1. 상단에 귀여운 파이썬 아이콘과 함께 큰 타이틀 출력
    st.title("🐍 파이썬 문법 마스터 퀴즈")
    
    # 2. 서브 설명글 출력
    st.subheader("교수님 수업 자료를 기반으로 만든 퀴즈입니다.")
    st.markdown("🏆 **랭킹**과 🌟 **EXP(경험치)** 시스템이 포함되어 있습니다!")
    
    # 깔끔한 UI 레이아웃을 위한 빈 여백(공백) 추가
    st.write("")
    
    # 입력 영역과 상단 헤더 영역을 구분짓는 시각적 구분선 배치
    st.divider()
    
    # 3. 플레이어의 학번을 입력받는 깔끔한 입력창
    student_id_input = st.text_input(
        "학번", 
        value=st.session_state.student_id, 
        placeholder="예: 202612345 (10자리 숫자로 입력해 주세요)"
    )
    
    # 3. 플레이어의 이름을 입력받는 깔끔한 입력창
    student_name_input = st.text_input(
        "이름", 
        value=st.session_state.student_name, 
        placeholder="예: 홍길동"
    )
    
    # 입력창에 텍스트가 타이핑될 때마다 세션 상태에 저장해 둡니다.
    st.session_state.student_id = student_id_input
    st.session_state.student_name = student_name_input
    
    # 입력창과 시작 버튼 사이의 적절한 간격을 위해 빈 줄 삽입
    st.write("")

    # 4. 누르면 다음 게임 화면으로 넘어갈 수 있는 눈에 띄는 "게임 시작 🎮" 버튼
    # use_container_width=True 설정을 통해 버튼을 화면 가로폭에 맞춰 큼직하고 보기 좋게 만듭니다.
    if st.button("게임 시작 🎮", use_container_width=True):
        # 학번 입력란이 비어 있는지 검증합니다.
        if not student_id_input.strip():
            st.error("학번을 입력해 주세요! ⚠️")
        # 이름 입력란이 비어 있는지 검증합니다.
        elif not student_name_input.strip():
            st.error("이름을 입력해 주세요! ⚠️")
        # 둘 다 정상 입력되었으면 게임 상태를 초기화하고 페이지 상태를 게임 진행 화면('game')으로 변경합니다.
        else:
            reset_game()
            st.session_state.page = "game"
            st.rerun()


# --- 2. [게임 대시보드 화면] 정의 함수 ---
def show_game_page():
    # 플레이어의 정보를 상단에 간결하게 출력합니다.
    st.caption(f"👤 플레이어: {st.session_state.student_name} ({st.session_state.student_id})")
    
    # 타이틀 표시
    st.title("🎯 파이썬 퀴즈 대시보드")
    
    # 상단 대시보드 컬럼 분할 (st.columns 활용)
    col1, col2 = st.columns(2)
    
    # 전체 문항 대비 남은 문항 수 계산
    remaining_count = st.session_state.total_questions - st.session_state.current_question + 1
    if st.session_state.game_over:
        remaining_count = 0
        
    # 첫 번째 열: 현재까지 획득한 EXP 점수를 st.metric으로 강조하여 표시
    with col1:
        st.metric(label="🏆 획득한 EXP", value=f"{st.session_state.score} EXP")
        
    # 두 번째 열: 현재 풀고 있는 문제 순서 및 남은 문제 수를 st.metric으로 표시
    with col2:
        st.metric(label="⏳ 남은 문제 수", value=f"{remaining_count} 개 / {st.session_state.total_questions}개 중")
        
    # 진행률 계산 (0.0 ~ 1.0 범위로 변환)
    if st.session_state.game_over:
        progress_val = 1.0
    else:
        progress_val = (st.session_state.current_question - 1) / st.session_state.total_questions
        
    # 게임 진행 상황을 직관적인 게이지 바로 출력 (st.progress 활용)
    st.progress(progress_val)
    st.write(f"📈 퀴즈 진행률: **{int(progress_val * 100)}%** 완료")
    
    # 대시보드 하단과 문제 영역 구분선
    st.divider()
    
    # --- 게임 오버(완료) 상태인 경우 ---
    if st.session_state.game_over:
        st.balloons()  # 축하용 풍선 애니메이션 효과 실행
        st.success("🎉 축하합니다! 모든 파이썬 문법 퀴즈를 완료했습니다!")
        st.write(f"최종 누적 점수: **{st.session_state.score} EXP**")
        
        st.write("")
        
        # 실시간 랭킹 시스템 (시뮬레이션)
        st.subheader("🏆 명예의 전당 (실시간 랭킹)")
        ranking_data = [
            {"순위": "1위", "학번": "202611002", "이름": "김철수", "점수": "500 EXP"},
            {"순위": "2위", "학번": "202611054", "이름": "이영희", "점수": "400 EXP"},
            {"순위": "3위", "학번": st.session_state.student_id, "이름": st.session_state.student_name, "점수": f"{st.session_state.score} EXP (나)"},
            {"순위": "4위", "학번": "202611099", "이름": "박민수", "점수": "200 EXP"},
        ]
        # 랭킹 표(table)를 깔끔하게 렌더링
        st.table(ranking_data)
        
        st.write("")
        
        # 다시 메인 화면으로 돌아갈 수 있는 처음으로 버튼 생성
        if st.button("처음으로 돌아가기 ↩️", use_container_width=True):
            reset_game()
            st.session_state.page = "main"
            st.rerun()
            
    # --- 현재 문제를 풀고 있는 진행 상태인 경우 ---
    else:
        # 현재 풀 문제의 데이터를 리스트에서 가져옵니다.
        q_data = QUIZ_DATA[st.session_state.current_question - 1]
        
        # 몇 번째 문제인지 및 문제 설명 출력
        st.write(f"### 📝 문제 {st.session_state.current_question}.")
        st.info(q_data["question"])
        
        # 퀴즈 보기 선택 영역
        # st.radio를 활용해 보기 리스트 중 하나를 고르도록 하며, 기본 선택값을 없애기 위해 index=None 설정
        user_choice = st.radio(
            "올바른 정답을 선택하세요:",
            options=q_data["options"],
            index=None,
            key=f"q_radio_{st.session_state.current_question}"
        )
        
        st.write("")
        
        # 아직 답안 제출을 안 한 상태일 때
        if not st.session_state.answered:
            # "정답 제출 📝" 버튼 활성화
            if st.button("정답 제출 📝", use_container_width=True):
                # 보기를 선택하지 않고 제출하려 할 경우
                if user_choice is None:
                    st.warning("정답을 선택해 주세요! ⚠️")
                else:
                    # 제출 처리 후 정답 여부를 판별합니다.
                    st.session_state.answered = True
                    if user_choice == q_data["answer"]:
                        st.session_state.is_correct = True
                        st.session_state.score += q_data["exp"]  # 점수 합산
                    else:
                        st.session_state.is_correct = False
                    st.rerun()
                    
        # 답안 제출을 완료한 상태일 때
        else:
            # 정답인 경우 녹색 성공 메시지 창 출력
            if st.session_state.is_correct:
                st.success(f"정답입니다! 🎉 (+{q_data['exp']} EXP 획득!)")
            # 오답인 경우 적색 에러 메시지 창 및 정답 안내 출력
            else:
                st.error(f"오답입니다. 😢 (정답: {q_data['answer']})")
                
            st.write("")
            
            # 다음 문제로 넘어가기 버튼 (마지막 문제일 때는 결과 확인 버튼으로 표시 변경)
            button_label = "다음 문제로 ➡️" if st.session_state.current_question < st.session_state.total_questions else "결과 확인하기 🏆"
            if st.button(button_label, use_container_width=True):
                # 퀴즈 상태를 다음 문제로 넘기거나 게임 종료로 설정합니다.
                st.session_state.answered = False
                if st.session_state.current_question < st.session_state.total_questions:
                    st.session_state.current_question += 1
                else:
                    st.session_state.game_over = True
                st.rerun()


# --- 3. 세션 상태에 따른 페이지 전환 조건문 ---
# 세션 상태의 page 값이 'main'이면 메인 화면을 보여줍니다.
if st.session_state.page == "main":
    show_main_page()
# 세션 상태의 page 값이 'game'이면 전환된 게임 화면을 보여줍니다.
elif st.session_state.page == "game":
    show_game_page()
